/* ngb.rc: recursos de ngb-loader.exe (/DNGB_RC_LOADER) y de ngb-core.dll (/DNGB_RC_CORE).
 * El icono va en los dos: el exe lo enseña el Explorador y la DLL lo carga la ventana del
 * juego (el exe pierde su cabecera PE cuando el XBE ocupa 0x10000, la DLL no). Solo ASCII
 * en los textos: rc.exe no lee UTF-8 sin banderas extra. */
#include <winver.h>
#include "version.h"

#ifdef NGB_RC_LOADER
#define NGB_RC_FILE "ngb-loader.exe"
#define NGB_RC_DESC "Ninja Gaiden Black - native port (loader)"
#define NGB_RC_TYPE VFT_APP
#else
#define NGB_RC_FILE "ngb-core.dll"
#define NGB_RC_DESC "Ninja Gaiden Black - native port (core)"
#define NGB_RC_TYPE VFT_DLL
#endif

1 ICON "ngb.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION NGB_VERSION_NUM
PRODUCTVERSION NGB_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE NGB_RC_TYPE
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", NGB_RC_DESC
            VALUE "FileVersion", NGB_VERSION_STR
            VALUE "InternalName", NGB_RC_FILE
            VALUE "OriginalFilename", NGB_RC_FILE
            VALUE "ProductName", "Ninja Gaiden Black native port"
            VALUE "ProductVersion", NGB_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
