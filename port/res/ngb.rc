/* ngb.rc: resources of ngb-loader.exe (/DNGB_RC_LOADER) and ngb-core.dll (/DNGB_RC_CORE).
 * The icon goes in both: Explorer shows the exe's and the game window loads the DLL's
 * (the exe loses its PE header when the XBE occupies 0x10000, the DLL does not). ASCII only
 * in the texts: rc.exe does not read UTF-8 without extra flags. */
#include <winver.h>
#include "version.h"

#ifdef NGB_RC_LOADER
#define NGB_RC_FILE "ngb-loader.exe"
#define NGB_RC_DESC "Unofficial Ninja Gaiden Black native port (loader)"
#define NGB_RC_TYPE VFT_APP
#else
#define NGB_RC_FILE "ngb-core.dll"
#define NGB_RC_DESC "Unofficial Ninja Gaiden Black native port (core)"
#define NGB_RC_TYPE VFT_DLL
#endif

1 ICON "ngb.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION NGB_VERSION_NUM
PRODUCTVERSION NGB_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE NGB_RC_TYPE
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", NGB_RC_DESC
            VALUE "FileVersion", NGB_VERSION_STR
            VALUE "InternalName", NGB_RC_FILE
            VALUE "OriginalFilename", NGB_RC_FILE
            VALUE "ProductName", "Ninja Gaiden Black native port (unofficial fan project)"
            VALUE "LegalCopyright", "(c) 2026 angeldev07 and contributors. GPL-3.0-or-later"
            VALUE "Comments", "Not affiliated with Koei Tecmo, Team Ninja or Microsoft. No game data included."
            VALUE "ProductVersion", NGB_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
