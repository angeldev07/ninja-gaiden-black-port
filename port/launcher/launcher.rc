/* launcher.rc: icono, manifiesto (DPI del sistema) y versión de ngb-launcher.exe. */
#include <winver.h>
#include "version.h"

1 ICON "ngb.ico"
1 RT_MANIFEST "launcher.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION NGB_VERSION_NUM
PRODUCTVERSION NGB_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Ninja Gaiden Black - native port launcher"
            VALUE "FileVersion", NGB_VERSION_STR
            VALUE "InternalName", "ngb-launcher.exe"
            VALUE "OriginalFilename", "ngb-launcher.exe"
            VALUE "ProductName", "Ninja Gaiden Black native port"
            VALUE "ProductVersion", NGB_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
