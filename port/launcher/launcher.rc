/* launcher.rc: icon, manifest (system DPI) and version of ngb-launcher.exe. */
#include <winver.h>
#include "version.h"

1 ICON "ngb.ico"
1 RT_MANIFEST "launcher.manifest"

/* Josefin Sans, a kanji subset of Shippori Mincho B1 and the brush dragon of Yuji Boku (all SIL OFL
 * 1.1, see port/res/fonts),
 * loaded privately by ui.c. */
101 RCDATA "../res/fonts/JosefinSans-Thin.ttf"
102 RCDATA "../res/fonts/JosefinSans-Light.ttf"
103 RCDATA "../res/fonts/JosefinSans-SemiBold.ttf"
104 RCDATA "../res/fonts/ShipporiMinchoB1-SemiBold-kanji.ttf"
105 RCDATA "../res/fonts/YujiBoku-Regular-dragon.ttf"

VS_VERSION_INFO VERSIONINFO
FILEVERSION NGB_VERSION_NUM
PRODUCTVERSION NGB_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Unofficial Ninja Gaiden Black native port launcher"
            VALUE "FileVersion", NGB_VERSION_STR
            VALUE "InternalName", "ngb-launcher.exe"
            VALUE "OriginalFilename", "ngb-launcher.exe"
            VALUE "ProductName", "Ninja Gaiden Black native port (unofficial fan project)"
            VALUE "LegalCopyright", "(c) 2026 angeldev07 and contributors. GPL-3.0-or-later"
            VALUE "Comments", "Not affiliated with Koei Tecmo, Team Ninja or Microsoft. No game data included."
            VALUE "ProductVersion", NGB_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
