# LF line endings in the repo for every text file, whatever the platform.
* text=auto eol=lf

*.png binary
*.jpg binary

# .cmd files use CRLF: cmd.exe miscomputes offsets in LF files with multibyte UTF-8 and,
# when returning from a `call`, resumes mid-line (an endless loop in the build).
*.cmd text eol=crlf
*.bat text eol=crlf
