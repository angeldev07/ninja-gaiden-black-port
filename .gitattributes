# Fin de línea LF en el repo para todos los archivos de texto, sin importar la plataforma.
* text=auto eol=lf

*.png binary
*.jpg binary

# Los .cmd van con CRLF: cmd.exe calcula mal los desplazamientos en archivos LF con UTF-8
# multibyte y, al volver de un `call`, retoma a mitad de línea (bucle infinito en el build).
*.cmd text eol=crlf
*.bat text eol=crlf
